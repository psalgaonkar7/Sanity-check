{
  "name": "raileurope-msc-automation",
  "version": "1.0.0",
  "description": "Automated daily Manual Sanity Check (MSC) for Rail Europe B2B using Playwright. Covers every carrier on the connectivity page (19 point-to-point sectors + 4 rail passes) across batched orders, plus SNCF Connect POS and read-only LocoHub API checks. Never pays, never submits to a carrier.",
  "scripts": {
    "auth": "node auth.js",
    "auth:b2b": "playwright test --project=setup --headed",
    "msc": "playwright test --project=b2b tests/b2b-msc.spec.js",
    "passes": "playwright test --project=b2b tests/b2b-passes.spec.js",
    "booking": "playwright test --project=b2b tests/b2b-msc.spec.js -g \"build cart\"",
    "b2c": "playwright test --project=b2c",
    "api": "node api-searchability.js",
    "sanity": "node run-sanity.js",
    "deck": "node deck/gen.js",
    "log": "node log-run.js",
    "weekly": "node weekly-report.js",
    "report": "playwright show-report report/html",
    "verify-routes": "node tools/verify-station-labels.js",
    "check-slack": "node notify.js --check-slack"
  },
  "keywords": [
    "raileurope",
    "msc",
    "sanity-check",
    "playwright",
    "qa"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  }
}
