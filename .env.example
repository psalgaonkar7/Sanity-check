# Copy this file to .env (same folder) and fill in what you need. .env is git-ignored —
# it holds the Slack webhook, which is a secret: anyone with the URL can post to the channel.

# Slack webhook for #sd_24-7 — a Workflow Builder webhook (hooks.slack.com/triggers/..., with a
# variable named "text") or a classic incoming webhook (hooks.slack.com/services/...).
# Check it with: npm run check-slack   Without it the run still prints the Slack line,
# it just does not post. How to create one: README, "Slack post".
SLACK_WEBHOOK_URL=

# Optional: pre-fill the To: line of the sanity mail draft (e.g. the DL's email address).
MAIL_TO=

# Optional: Salesforce CLI org alias used for the "SF cases not linked with an SR" count.
SF_ORG_ALIAS=re-prod

# Optional: force the slot in the Slack line / mail (default: run start rounded to the hour, IST).
# MSC_SLOT=00:00

# Optional overrides — only if your setup differs.
# AWS_CLI=C:\path\to\aws.exe
