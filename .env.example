# Copy this file to .env (same folder) and fill in what you need. .env is git-ignored.

# The result DM goes through the Pratikesh Assistant webhook, SLACK_ALERT_WEBHOOK. It is normally
# already set in your Windows user environment (setx) for RE/Assistant, and the run reads it from
# there — only set it here if it is not. It is a secret: anyone with the URL can DM you.
# Nothing is posted to a team channel any more (the #sd_24-7 "Sanity Bot" was retired 2026-10-20).
# SLACK_ALERT_WEBHOOK=

# Optional: pre-fill the To: line of the sanity mail draft (e.g. the DL's email address).
MAIL_TO=

# Optional: Salesforce CLI org alias used for the "SF cases not linked with an SR" count.
SF_ORG_ALIAS=re-prod

# Optional: force the slot in the DM / mail (default: run start rounded to the hour, IST).
# MSC_SLOT=00:00

# Optional overrides — only if your setup differs.
# AWS_CLI=C:\path\to\aws.exe
# SANITY_TRACKER_URL=https://...
